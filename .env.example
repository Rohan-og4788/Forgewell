# Server Configuration
PORT=3001
NODE_ENV=development
APP_URL=http://localhost:5173

# Database Connection (Supabase PostgreSQL)
# Example: postgresql://postgres.[project-ref]:[db-password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/forgewell?schema=public"
# DIRECT_URL="postgresql://postgres:postgres@localhost:5432/forgewell?schema=public"

# Supabase Authentication & Storage
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# Security & Cryptography
# 32-byte hex key for AES-256-GCM encryption of OAuth tokens (generate with: openssl rand -hex 32)
ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
JWT_SECRET="forgewell-super-secure-jwt-secret-key-at-least-32-chars-long"

# GitHub OAuth Integration
GITHUB_CLIENT_ID="your-github-client-id"
GITHUB_CLIENT_SECRET="your-github-client-secret"
GITHUB_CALLBACK_URL="http://localhost:3001/api/github/callback"

# AI / LLM Providers (OpenAI, Gemini, Anthropic, Groq, or Fallback)
AI_PROVIDER="openai" # openai | anthropic | gemini | groq
OPENAI_API_KEY="sk-your-openai-api-key"
GEMINI_API_KEY="your-gemini-api-key"
ANTHROPIC_API_KEY="your-anthropic-api-key"
GROQ_API_KEY="your-groq-api-key"

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000 # 15 minutes
RATE_LIMIT_MAX_REQUESTS=100

